{
  "name": "odekake-paper",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "audit:fare-gates": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/auditFareGateTopology.ts",
    "audit:station-guides": "node scripts/run-audit-reports.mjs scripts/auditStationGuideRouteIntegrity.test.ts",
    "audit:vertical-consensus": "node scripts/run-audit-reports.mjs scripts/auditVerticalMovementConsensus.test.ts",
    "audit:kokuritsu-canonical": "node scripts/run-audit-reports.mjs scripts/auditKokuritsuCanonicalRoute.test.ts",
    "audit:kokuritsu-elderly": "node scripts/run-audit-reports.mjs scripts/auditKokuritsuElderlyRoute.test.ts",
    "audit:kokuritsu-boarding-best": "node scripts/run-audit-reports.mjs scripts/auditKokuritsuBoardingBestRoutes.test.ts",
    "audit:elderly-car-positions": "node scripts/run-audit-reports.mjs scripts/auditElderlyCarPosition.test.ts",
